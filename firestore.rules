rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCloudNote(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 100000 &&
             data.isPinned is bool &&
             data.clientCreatedAtMillis is int && data.clientCreatedAtMillis >= 0 &&
             data.clientUpdatedAtMillis is int && data.clientUpdatedAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCloudHistoryEntry(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.expression is string && data.expression.size() >= 1 && data.expression.size() <= 20000 &&
             data.result is string && data.result.size() >= 1 && data.result.size() <= 100000 &&
             data.calculatorMode in ['STANDARD', 'SCIENTIFIC'] &&
             data.angleUnit in ['DEG', 'RAD'] &&
             data.precision is int && data.precision >= 1 && data.precision <= 500 &&
             data.isApproximated is bool &&
             data.clientCreatedAtMillis is int && data.clientCreatedAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /notes/{noteId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(noteId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(noteId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'isPinned', 'clientCreatedAtMillis', 'clientUpdatedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'isPinned', 'clientCreatedAtMillis', 'clientUpdatedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidCloudNote(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(noteId) &&
                         request.auth.uid == userId &&
                         isValidCloudNote(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().clientCreatedAtMillis == existing().clientCreatedAtMillis &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'isPinned', 'clientUpdatedAtMillis', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(noteId) && request.auth.uid == userId;
      }

      match /history/{historyId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(historyId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(historyId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'expression', 'result', 'calculatorMode', 'angleUnit', 'precision', 'isApproximated', 'clientCreatedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'expression', 'result', 'calculatorMode', 'angleUnit', 'precision', 'isApproximated', 'clientCreatedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidCloudHistoryEntry(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(historyId) &&
                         request.auth.uid == userId &&
                         isValidCloudHistoryEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().clientCreatedAtMillis == existing().clientCreatedAtMillis &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['expression', 'result', 'calculatorMode', 'angleUnit', 'precision', 'isApproximated', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(historyId) && request.auth.uid == userId;
      }
    }
  }
}
